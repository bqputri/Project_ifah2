# ==========================================
# KONFIGURASI SERVER & PORT
# ==========================================
PORT=3000

# ==========================================
# GOOGLE GEMINI AI API KEY (Wajib untuk AI Generator)
# ==========================================
# Dapatkan API key gratis di Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ==========================================
# FIREBASE CONFIGURATION (Direkomendasikan untuk Cloud Auth & Balapan Online Real-Time)
# ==========================================
# Dapatkan gratis di Firebase Console: https://console.firebase.google.com/
# Aktifkan:
# 1. Authentication -> Sign-in method -> Email/Password & Google
# 2. Build -> Realtime Database -> Create Database (Start in test mode)
# 3. Project Settings -> General -> Your apps -> Tambah Web App (</>)
#
# Opsi A: Satu per satu (Mudah disalin dari Firebase Console):
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# Opsi B (Alternatif JSON string):
# FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"...","databaseURL":"..."}

# ==========================================
# SUPABASE CONFIGURATION (Opsional - Cadangan)
# ==========================================
# SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ==========================================
# GMAIL FEEDBACK & BUG REPORT (Nodemailer)
# ==========================================
# Alamat Gmail pengirim:
GMAIL_USER=YOUR_GMAIL_ADDRESS@gmail.com

# 16-Karakter Sandi Aplikasi Google (Google App Password):
# Dapatkan di: https://myaccount.google.com/apppasswords
# (Catatan: Verifikasi 2 Langkah / 2-Step Verification pada Akun Google harus aktif)
GMAIL_APP_PASSWORD=your_16_char_app_password

# Alamat Gmail penerima pesan masukan (default sama dengan GMAIL_USER):
GMAIL_RECEIVER=YOUR_GMAIL_ADDRESS@gmail.com
